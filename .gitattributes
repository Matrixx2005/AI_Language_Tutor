# Chuẩn hóa xuống dòng: lưu LF trong Git, tránh lỗi CRLF khi file chạy trong Docker/Linux.
* text=auto eol=lf

# Script Windows cần CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Bản lưu trữ phải giữ nguyên từng byte (README ghi SHA-256).
data/archive/** -text

# Nhị phân
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
