# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.

# LLM (model ID kiểm tra theo tài liệu chính thức khi tích hợp, Tuần 3)
LLM_PROVIDER=gemini
LLM_MODEL_ID=
GEMINI_API_KEY=

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# Cơ sở dữ liệu
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_language_tutor
QDRANT_URL=http://localhost:6333

# Ngôn ngữ mặc định của hệ thống
DEFAULT_LANGUAGE_CODE=en
