# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.
# Biến để trống (POSTGRES_PASSWORD, JWT_SECRET...) là bắt buộc phải điền.

# Môi trường: development bật CORS cho Vite (localhost:5173); giá trị khác thì tắt CORS.
ENVIRONMENT=development
# Tùy chọn: origin được gọi API, cách nhau bằng dấu phẩy, không dùng '*'.
# Để trống: development cho phép Vite (localhost:5173, 127.0.0.1:5173); môi trường khác tắt CORS.
CORS_ORIGINS=

# LLM. `fake` = câu trả lời giả, không gọi mạng, không tốn hạn mức (mặc định an toàn). Lượt `fake`
# được lưu với model_id `fake:...` và KHÔNG tính vào giới hạn ngày/toàn hệ thống (vẫn tính giới hạn
# phút mỗi người). Sau khi đổi sang `gemini`, nên tạo cuộc trò chuyện MỚI (tránh trả lời giả trong lịch sử).
# Đổi sang `gemini` khi đã có key. Model ID kiểm tra theo ai.google.dev/gemini-api/docs/models;
# không dùng alias `*-latest` (bị đổi model ngầm → kết quả thí nghiệm không lặp lại được).
LLM_PROVIDER=gemini
# Trạng thái kiểm chứng thật (gói miễn phí, 2026-11-23, xem docs/ENVIRONMENT_CHECK.md):
# - gemini-3.5-flash-lite: ĐÃ KIỂM CHỨNG — text và structured output đều 200 OK, ~1,4 giây.
# - gemini-3.8-flash: CHƯA trả lời thành công lần nào (lần 1: 504 DEADLINE_EXCEEDED ~30 giây,
#   lần 2: 503 UNAVAILABLE) → chỉ dùng làm dự phòng.
LLM_MODEL_ID=gemini-3.5-flash-lite
# Model dự phòng khi model chính hết hạn mức/quá tải (cách nhau bằng dấu phẩy; có thể để trống).
LLM_FALLBACK_MODEL_IDS=gemini-3.8-flash
# Thời gian chờ mỗi lần gọi (giây) và số lần thử lại cho lỗi tạm thời (0–3; ít để tiết kiệm hạn mức).
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1024
# Mức "suy nghĩ" của Gemini: minimal | low | medium | high, để trống = mặc định của model.
# `low` nhanh và ít token (gemini-3.8-flash mặc định `medium`, KHÔNG hỗ trợ `minimal`).
GEMINI_THINKING_LEVEL=low
# Key CHỈ đặt trong .env (không bao giờ ở file này — file này được commit lên Git).
GEMINI_API_KEY=

# Chat: số lượt gần nhất gửi cho LLM (mỗi lượt = 1 câu hỏi + 1 trả lời; lượt lỗi không tính),
# 0–50. Nhiều lượt = AI nhớ ngữ cảnh hơn nhưng tốn token/hạn mức hơn.
CHAT_HISTORY_TURNS=10
# Độ dài tối đa mỗi tin người dùng (ký tự), 1–10000. Tin dài hơn bị từ chối (422 message_too_long).
CHAT_MAX_MESSAGE_CHARS=2000

# --- Giới hạn tần suất (0 = tắt giới hạn đó) ---
# Bộ đếm phút/IP nằm trong BỘ NHỚ: chỉ đúng khi chạy MỘT tiến trình (nhiều worker cần Redis, Tuần 8).
# Mỗi người dùng: số tin chat mỗi phút (429 chat_rate_limited) và mỗi ngày theo USER_TIMEZONE
# (429 chat_daily_limit_reached; đếm từ DB, lượt hỏng do hệ thống/nhà cung cấp không tính).
CHAT_USER_PER_MINUTE=6
CHAT_USER_PER_DAY=40
# Số tin đang chờ trả lời cùng lúc của một người (1 = phải chờ tin trước xong; 409 chat_busy).
CHAT_MAX_CONCURRENT_PER_USER=1
# TOÀN HỆ THỐNG (cả app dùng chung một key). Gói free gemini-3.5-flash-lite: 15 RPM → để 10, chừa dư
# địa cho thử lại/model dự phòng. LLM_GLOBAL_PER_DAY: đặt THẤP HƠN RPD thật trong AI Studio (0 = tắt).
# Lưu ý: LLM_GLOBAL_PER_MINUTE đếm REQUEST của người dùng, không đếm lời gọi thật; mỗi request có thể gây
# tối đa (1 + LLM_MAX_RETRIES) × số model lời gọi. Điểm xuất phát: 15 ÷ (1 + LLM_MAX_RETRIES).
LLM_GLOBAL_PER_MINUTE=10
LLM_GLOBAL_PER_DAY=0
# Khi nhà cung cấp báo HẾT HẠN MỨC NGÀY (đã thử cả model dự phòng): tạm khóa gọi LLM toàn hệ thống trong
# bấy nhiêu giây (60–3600) thay vì tối đa 60s. 0 = như giới hạn theo phút. Giới hạn theo phút không đổi.
LLM_QUOTA_COOLDOWN_SECONDS=900
# Đăng nhập SAI quá số lần trong cửa sổ (giây) → 429 auth_rate_limited; đăng nhập đúng xóa bộ đếm email.
AUTH_LOGIN_FAILS_PER_EMAIL=5
AUTH_LOGIN_FAILS_PER_IP=20
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_PER_IP_PER_HOUR=10
# Múi giờ xác định ranh giới "ngày" cho giới hạn theo ngày (tên IANA).
USER_TIMEZONE=Asia/Ho_Chi_Minh
# Số reverse proxy TIN CẬY đứng trước app. 0 = KHÔNG đọc X-Forwarded-For (ai cũng giả được), chỉ dùng
# IP kết nối. Chỉ đặt > 0 khi triển khai sau proxy mình kiểm soát (Tuần 8).
TRUSTED_PROXY_COUNT=0

# RAG (Tuần 4). Mọi biến đều có mặc định trong code; chỉ cần đặt khi muốn đổi.
# Chế độ trả lời mặc định: llm_only | dense | hybrid (giao diện vẫn cho chọn từng tin).
RAG_MODE=llm_only
RAG_TOP_K=3
# RRF: hằng số k và số ứng viên mỗi nhánh (BM25, dense) trước khi hợp nhất.
RAG_RRF_K=60
RAG_CANDIDATES=20
# index_text có thêm từ khóa tiếng Việt (data/processed/keywords_vi_v1.json). Xem experiments/README.md trước khi bật.
RAG_INDEX_KEYWORDS_VI=false
# Lọc tài liệu theo trình độ của người học (mặc định tắt để đánh giá công bằng).
RAG_FILTER_LEVEL=false
# Model nhúng (ghim revision). Cache model đặt trên ổ còn nhiều chỗ; tương đối với thư mục gốc dự án.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_CACHE_DIR=models/hf

# Cơ sở dữ liệu PostgreSQL — docker-compose.yml và backend cùng đọc các biến này.
# Đặt mật khẩu ngẫu nhiên, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Dùng 127.0.0.1 thay vì localhost (Windows thử IPv6 trước, Docker chỉ mở IPv4 → chậm/treo).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=tutor
POSTGRES_PASSWORD=
POSTGRES_DB=ai_language_tutor
POSTGRES_TEST_DB=ai_language_tutor_test
# Tùy chọn: số giây chờ kết nối DB trước khi báo lỗi (mặc định 10).
# POSTGRES_CONNECT_TIMEOUT=10

# Xác thực (JWT). Secret >= 32 ký tự, mỗi máy một giá trị riêng, không commit.
# Sinh: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Vector store (Tuần 4). Dùng 127.0.0.1 (localhost sẽ được code đổi sang 127.0.0.1 vì chậm ~2 s/lời gọi trên Windows).
QDRANT_URL=http://127.0.0.1:6333
QDRANT_TIMEOUT_SECONDS=5

# Ngôn ngữ mặc định của hệ thống
DEFAULT_LANGUAGE_CODE=en
